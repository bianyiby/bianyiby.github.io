---
---
{%- assign paper_url = entry.url | default: entry.html -%}
{%- if paper_url == nil and entry.doi -%}{%- assign paper_url = 'https://doi.org/' | append: entry.doi -%}{%- endif -%}
{%- capture title -%}{% if paper_url %}<a href="{{ paper_url | escape }}" target="_blank" rel="noopener noreferrer">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}{%- endcapture -%}
{%- capture author_html -%}{% include publication_authors.html entry=entry %}{%- endcapture -%}
{%- capture citation -%}{{ author_html | strip }}, {% include publication_venue.html entry=entry %}. {% include publication_badges.html entry=entry %}{%- endcapture -%}

{% if entry.preview %}
<div class="paper-box" data-key="{{ entry.key | escape }}">
  <div class="paper-box-image">
    <div>
      {% if entry.abbr %}<div class="badge">{{ entry.abbr }}</div>{% endif %}
      <img src="{{ entry.preview | relative_url }}" alt="{{ entry.title | strip_html | escape }}" width="100%" onclick="event.stopPropagation();document.getElementById('img-lightbox-img').src=this.src;document.getElementById('img-lightbox').classList.add('open')" style="cursor:zoom-in">
    </div>
  </div>
  <div class="paper-box-text">
    <p>{{ title }}</p>
    <p>{{ citation }}</p>
    {% if entry.abstract %}
    <div class="hl-abstract collapsed">
      <div class="hl-abstract-text"><span class="hl-abstract-label">Abstract: </span>{{ entry.abstract }}</div>
      <span class="hl-abstract-toggle" role="button" onclick="event.stopPropagation();toggleHlAbstract(this)">&#9662; Expand</span>
    </div>
    {% endif %}
  </div>
</div>
{% else %}
<p data-key="{{ entry.key | escape }}">{% if entry.abbr %}<span class="ccf-badge ccf-abbr">{{ entry.abbr }}</span> {% endif %}{{ title }}<br>
{{ citation }}</p>
{% endif %}
