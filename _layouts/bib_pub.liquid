---
---
{%- capture author_html -%}{% include publication_authors.html entry=entry %}{%- endcapture -%}
<p data-key="{{ entry.key | escape }}" data-category="{{ entry.category | default: 'Other' | escape }}" data-year="{{ entry.year | escape }}"><span class="publication-citation">{{ author_html | strip }}, &ldquo;{{ entry.title }},&rdquo; {% include publication_venue.html entry=entry %}{% if entry.doi %}, <a class="publication-doi" href="https://doi.org/{{ entry.doi | escape }}" target="_blank" rel="noopener noreferrer">doi: {{ entry.doi }}</a>{% elsif entry.url %}, <a href="{{ entry.url | escape }}" target="_blank" rel="noopener noreferrer">Online</a>{% endif %}. {% include publication_badges.html entry=entry abbreviation=true %}</span></p>
<div class="pub-buttons">
  <div class="pub-btn-row">
    {% if entry.abstract %}<a class="pub-btn pub-abs-btn" role="button">Abs</a>{% endif %}
    {% unless entry.bibtex_show == 'false' %}<a class="pub-btn pub-bib-btn" role="button">Bib</a>{% endunless %}
  </div>
  <div class="pub-content hidden"></div>
  {% if entry.abstract %}<div class="pub-abstract-data hidden">{{ entry.abstract }}</div>{% endif %}
  {% unless entry.bibtex_show == 'false' %}<div class="pub-bibtex-data hidden"><pre>{{ entry.bibtex | publication_bibtex | escape }}</pre></div>{% endunless %}
</div>
